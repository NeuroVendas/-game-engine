        "Script": {
          "name": "core.relay.a",
          "kind": "Script",
          "enabled": true,
          "source": "const state = Forge.require(\"core.relay.state\");\n\nForge.onInteract(() => {\n  const result = state.activate(\"A\");\n  Forge.self.setColor(result.newlyActivated ? \"#b7f34a\" : \"#6f7d84\");\n  Forge.ui.setText(\"ObjectiveText\", result.message);\n  Forge.ui.setText(\"CounterText\", result.count + \" / 3 relays online\");\n  Forge.audio.play(\"RelayBeep\");\n\n  if (result.complete) {\n    Forge.emit(\"core.complete\");\n  }\n});"
        }
      }
