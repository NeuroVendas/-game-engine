        0
      ],
      "size": [
        1,
        1,
        1
      ],
      "components": {
        "Script": {
          "name": "core.relay.controller",
          "kind": "Script",
          "enabled": true,
          "source": "Forge.onStart(() => {\n  Forge.ui.setText(\"ObjectiveText\", \"Activate the 3 relay consoles\");\n  Forge.ui.setText(\"CounterText\", \"0 / 3 relays online\");\n  Forge.log(\"CORE_RELAY_READY\");\n});\n\nForge.on(\"core.complete\", () => {\n  const door = Forge.world.get(\"ExitDoor\");\n  const core = Forge.world.get(\"Core\");\n\n  if (door) door.move(0, 5, 0);\n  if (core) core.setColor(\"#b7f34a\");\n\n  Forge.ui.setText(\"ObjectiveText\", \"CORE ONLINE • YOU WIN\");\n  Forge.ui.setText(\"CounterText\", \"3 / 3 relays online\");\n  Forge.audio.play(\"RelayBeep\");\n  Forge.vfx.restart(\"CoreVictoryVFX\");\n  Forge.log(\"CORE_RELAY_WIN\");\n});"
        }
      }
