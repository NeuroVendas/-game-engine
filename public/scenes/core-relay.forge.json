      "size": [
        1,
        1,
        1
      ],
      "components": {
        "Script": {
          "name": "core.relay.state",
          "kind": "ModuleScript",
          "enabled": true,
          "source": "const active = new Set();\n\nForge.module({\n  activate(relay) {\n    const before = active.size;\n    active.add(relay);\n    const count = active.size;\n    const complete = count === 3;\n    return {\n      count,\n      complete,\n      newlyActivated: count > before,\n      message: complete\n        ? \"CORE ONLINE • Exit unlocked!\"\n        : \"Relay \" + relay + \" online • find \" + (3 - count) + \" more\"\n    };\n  },\n  count() {\n    return active.size;\n  }\n});"
        }
      }
    },
    {
      "id": "GameController",
      "name": "Game Controller",
      "kind": "empty",
      "position": [
        0,
